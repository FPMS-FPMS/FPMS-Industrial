<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FPMS-AS1 "Manta" — Flight Simulator</title>
<style>
  :root{
    --bg:#0b0f14; --panel:#121922; --panel2:#18212c; --line:#243040;
    --tx:#dbe6f2; --dim:#7f92a6; --acc:#3fb9d8; --ok:#4ad07f; --warn:#e8b73f; --bad:#e8574a;
    --mono:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--tx);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;overflow:hidden}
  #view{position:fixed;inset:0}
  canvas{display:block}

  #boot{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;
    flex-direction:column;gap:14px;z-index:200;transition:opacity .4s}
  #boot h1{margin:0;font-size:20px;letter-spacing:.14em;font-weight:600}
  #boot .sub{color:var(--dim);font-size:12px;font-family:var(--mono)}
  #bar{width:280px;height:3px;background:var(--line);border-radius:2px;overflow:hidden}
  #barf{height:100%;width:0%;background:var(--acc);transition:width .25s}

  .panel{position:fixed;background:rgba(18,25,34,.93);border:1px solid var(--line);
    border-radius:8px;backdrop-filter:blur(6px)}
  #left{left:12px;top:12px;width:250px;padding:12px;max-height:calc(100vh - 24px);overflow-y:auto}
  #left::-webkit-scrollbar{width:6px}
  #left::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}
  #hud{right:12px;top:12px;width:236px;padding:12px}
  #mapw{right:12px;bottom:12px;width:262px;padding:10px}
  #logw{left:12px;bottom:12px;width:250px;padding:10px}

  h3{margin:0 0 8px;font-size:10px;letter-spacing:.16em;color:var(--acc);
    text-transform:uppercase;font-weight:700}
  .grp{margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--line)}
  .grp:last-child{border:0;margin:0;padding:0}

  .modes{display:grid;grid-template-columns:1fr 1fr;gap:5px}
  button{background:var(--panel2);border:1px solid var(--line);color:var(--tx);
    padding:7px 6px;border-radius:5px;cursor:pointer;font-size:11px;font-weight:600;
    letter-spacing:.04em;transition:.15s;font-family:inherit}
  button:hover{border-color:var(--acc);color:var(--acc)}
  button.on{background:var(--acc);color:#06121a;border-color:var(--acc)}
  button.wide{width:100%;margin-top:5px}
  button.danger:hover{border-color:var(--bad);color:var(--bad)}

  label{display:block;font-size:10px;color:var(--dim);margin:9px 0 3px;
    letter-spacing:.06em;text-transform:uppercase}
  label span{float:right;color:var(--tx);font-family:var(--mono);font-size:10px}
  input[type=range]{width:100%;height:3px;-webkit-appearance:none;appearance:none;
    background:var(--line);border-radius:2px;outline:none;margin:3px 0}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:13px;height:13px;
    border-radius:50%;background:var(--acc);cursor:pointer}
  input[type=range]::-moz-range-thumb{width:13px;height:13px;border:0;border-radius:50%;
    background:var(--acc);cursor:pointer}

  .row{display:flex;justify-content:space-between;font-size:11px;padding:3px 0;
    font-family:var(--mono)}
  .row b{color:var(--dim);font-weight:400}
  .row s{text-decoration:none;color:var(--tx)}

  .meter{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin:2px 0 7px}
  .meter i{display:block;height:100%;background:var(--ok);transition:width .2s,background .2s}

  #modeTag{font-family:var(--mono);font-size:15px;font-weight:700;letter-spacing:.1em;
    color:var(--acc);text-align:center;padding:6px;background:var(--panel2);
    border-radius:5px;margin-bottom:9px}
  #alert{font-size:10px;text-align:center;padding:5px;border-radius:4px;margin-top:8px;
    display:none;font-weight:600;letter-spacing:.05em}
  #alert.w{display:block;background:rgba(232,183,63,.15);color:var(--warn);
    border:1px solid rgba(232,183,63,.4)}
  #alert.e{display:block;background:rgba(232,87,74,.15);color:var(--bad);
    border:1px solid rgba(232,87,74,.4)}

  #map{width:100%;border-radius:5px;background:#0d141b;cursor:crosshair;display:block}
  .hint{font-size:9px;color:var(--dim);margin-top:5px;line-height:1.5}
  #log{height:88px;overflow-y:auto;font-family:var(--mono);font-size:9.5px;
    line-height:1.55;color:var(--dim)}
  #log::-webkit-scrollbar{width:5px}
  #log::-webkit-scrollbar-thumb{background:var(--line)}
  #log div{padding:1px 0;border-bottom:1px solid rgba(36,48,64,.35)}
  .kb{font-size:9px;color:var(--dim);margin-top:7px;line-height:1.6;font-family:var(--mono)}
</style>
</head>
<body>

<div id="view"></div>

<div id="boot">
  <h1>FPMS-AS1 &nbsp;&ldquo;MANTA&rdquo;</h1>
  <div class="sub" id="bootmsg">initialising flight model</div>
  <div id="bar"><div id="barf"></div></div>
</div>

<!-- ─────────── CONTROLS ─────────── -->
<div class="panel" id="left">
  <div class="grp">
    <h3>Flight Mode</h3>
    <div class="modes">
      <button id="mHOVER" class="on">HOVER</button>
      <button id="mPOSHOLD">POS HOLD</button>
      <button id="mCRUISE">CRUISE</button>
      <button id="mMISSION">MISSION</button>
    </div>
    <button class="wide" id="btnArm">ARM &amp; LAUNCH</button>
    <button class="wide danger" id="btnReset">RESET FLIGHT</button>
  </div>

  <div class="grp">
    <h3>Manual Input</h3>
    <label>Throttle <span id="vThr">0%</span></label>
    <input type="range" id="sThr" min="0" max="100" value="0">
    <label>Target Altitude AGL <span id="vAlt">30 m</span></label>
    <input type="range" id="sAlt" min="3" max="220" value="30">
    <label>Cruise Airspeed <span id="vAs">18 m/s</span></label>
    <input type="range" id="sAs" min="11" max="26" value="18">
    <div class="kb">A / D &nbsp;yaw &nbsp;&nbsp; W / S &nbsp;pitch<br>Q / E &nbsp;throttle trim</div>
  </div>

  <div class="grp">
    <h3>Environment</h3>
    <label>Wind Speed <span id="vWs">0 m/s</span></label>
    <input type="range" id="sWs" min="0" max="16" value="0" step="0.5">
    <label>Wind Direction <span id="vWd">0&deg;</span></label>
    <input type="range" id="sWd" min="0" max="359" value="0">
    <label>Gust Intensity <span id="vGu">30%</span></label>
    <input type="range" id="sGu" min="0" max="100" value="30">
  </div>

  <div class="grp">
    <h3>Mission</h3>
    <button class="wide" id="btnStart">START MISSION</button>
    <button class="wide" id="btnRTH">RETURN HOME</button>
    <button class="wide" id="btnClear">CLEAR WAYPOINTS</button>
    <div class="hint">Click the map to drop spray waypoints. The aircraft cruises out,
      transitions to hover, descends, sprays, climbs, then returns and lands.</div>
  </div>

  <div class="grp">
    <h3>Camera</h3>
    <div class="modes">
      <button id="cFOLLOW" class="on">FOLLOW</button>
      <button id="cCHASE">CHASE</button>
      <button id="cORBIT">ORBIT</button>
      <button id="cFPV">NOSE CAM</button>
    </div>
    <button class="wide" id="cINSPECT">INSPECT AIRFRAME</button>
    <button class="wide" id="btnLock">VIEW LOCK: OFF</button>
    <label>Camera Distance <span id="vZoom">14.0 m</span></label>
    <input type="range" id="sZoom" min="0.55" max="60" value="14" step="0.05">
    <button class="wide" id="btnSpin">AUTO-ROTATE: OFF</button>
    <label>Nacelle Tilt Scrub <span id="vTiltI">0&deg;</span></label>
    <input type="range" id="sTiltI" min="0" max="90" value="0">
    <div class="hint">ORBIT / INSPECT: drag to rotate, scroll or use the slider to zoom.
      The tilt scrubber drives the real servos at their true 45&deg;/s slew rate &mdash;
      it only works while disarmed.</div>
  </div>
</div>

<!-- ─────────── TELEMETRY ─────────── -->
<div class="panel" id="hud">
  <div id="modeTag">DISARMED</div>
  <div class="row"><b>ALT AGL</b><s id="tAlt">0.0 m</s></div>
  <div class="row"><b>GND SPEED</b><s id="tGs">0.0 m/s</s></div>
  <div class="row"><b>AIRSPEED</b><s id="tAs">0.0 m/s</s></div>
  <div class="row"><b>VERT SPEED</b><s id="tVs">0.0 m/s</s></div>
  <div class="row"><b>HEADING</b><s id="tHdg">000&deg;</s></div>
  <div class="row"><b>PITCH</b><s id="tPit">0.0&deg;</s></div>
  <div class="row"><b>ROLL</b><s id="tRol">0.0&deg;</s></div>

  <h3 style="margin-top:11px">Propulsion</h3>
  <div class="row"><b>NACELLE TILT</b><s id="tTilt">0&deg;</s></div>
  <div class="row"><b>THROTTLE</b><s id="tThr">0%</s></div>
  <div class="meter"><i id="mThr" style="width:0%"></i></div>
  <div class="row"><b>THRUST T1/T2</b><s id="tT12">0 g</s></div>
  <div class="row"><b>THRUST M3</b><s id="tT3">0 g</s></div>
  <div class="row"><b>POWER DRAW</b><s id="tPw">0 W</s></div>

  <h3 style="margin-top:11px">Battery — Live</h3>
  <div class="row"><b>PACK VOLTAGE</b><s id="tVolt">16.80 V</s></div>
  <div class="row"><b>CELL AVG</b><s id="tCell">4.20 V</s></div>
  <div class="row"><b>CURRENT</b><s id="tAmp">0.0 A</s></div>
  <div class="row"><b>STATE OF CHARGE</b><s id="tBat">100%</s></div>
  <div class="meter"><i id="mBat" style="width:100%"></i></div>
  <div class="row"><b>mAh USED</b><s id="tMah">0 / 5000</s></div>
  <div class="row"><b>Wh USED</b><s id="tWh">0.0 / 74.0</s></div>
  <div class="row"><b>ENDURANCE LEFT</b><s id="tEnd">--</s></div>

  <h3 style="margin-top:11px">Payload</h3>
  <div class="row"><b>WATER TANK</b><s id="tTank">120 mL</s></div>
  <div class="meter"><i id="mTank" style="width:100%;background:var(--acc)"></i></div>
  <div class="row"><b>FLIGHT TIME</b><s id="tFt">00:00</s></div>
  <div id="alert"></div>
</div>

<!-- ─────────── MAP ─────────── -->
<div class="panel" id="mapw">
  <h3>Tactical Map <span style="float:right;color:var(--dim);font-weight:400;
    letter-spacing:0;text-transform:none" id="mapScale">1600 m</span></h3>
  <canvas id="map" width="242" height="242"></canvas>
  <div class="hint">Cyan = aircraft &middot; Green = home &middot; Amber = waypoint &middot; Blue = water</div>
</div>

<!-- ─────────── LOG ─────────── -->
<div class="panel" id="logw">
  <h3>Flight Log</h3>
  <div id="log"></div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
"use strict";

/* ══════════════════════════════════════════════════════════════════
   FPMS-AS1 "MANTA" — flight dynamics driven by the locked build spec
   Y3 tiltrotor delta flying wing.
   T1 / T2 = front tilting motors.  M3 = fixed tail lift motor.
   ══════════════════════════════════════════════════════════════════ */

/* ---------- 1. VEHICLE CONSTANTS (from the locked BOM) ---------- */
const SPEC = {
  mass:        0.95,     // kg  all-up weight
  motorTmax:  12.75,     // N   per motor, ~1300 g  (T-Motor F80 1900KV / HQProp 7x4.5)
  propR:       0.089,    // m   7 inch propeller radius
  wingArea:    0.18,     // m^2 delta planform
  wingSpan:    0.80,     // m
  AR:          3.56,     // aspect ratio  b^2/S
  CD0:         0.028,
  CLa:         2.90,     // per radian (low-AR delta)
  CL0:         0.04,
  CLmax:       1.10,
  oswald:      0.75,
  paraCdA:     0.0055,   // m^2  CD x frontal area of pod + 3 nacelles (~0.009 m^2 @ CD 0.6)
  batteryWh:  74.0,      // 4S 5000 mAh Li-ion  (14.8 V x 5 Ah)
  packV:      14.8,
  packAh:      5.0,      // capacity
  packR:       0.060,    // ohm, internal resistance of 4x 21700 high-drain cells
  avionicsW:  14.0,      // FC + GPS + telemetry + Cubie A7S + 5G module
  tankML:    120,
  sprayMLs:   25,        // mL per second
  tiltRate:   45,        // deg/s  servo slew limit
  cruiseTilt: 88,        // deg
  crashVy:     6.0,      // m/s vertical impact limit
  crashVh:    15.0       // m/s horizontal impact limit
};
const G = 9.81, RHO = 1.225;
const DISK = Math.PI * SPEC.propR * SPEC.propR;
const WEIGHT = SPEC.mass * G;
const BATT_J = SPEC.batteryWh * 3600;
// throttle needed to hover: T = Tmax * thr^2 , 3 motors
const HOVER_THR = Math.sqrt(WEIGHT / (3 * SPEC.motorTmax));
const STALL_V = Math.sqrt(2 * WEIGHT / (RHO * SPEC.wingArea * SPEC.CLmax));

/* ---------- 2. HELPERS ---------- */
const clamp = (v,a,b)=> v<a?a:(v>b?b:v);
const lerp  = (a,b,t)=> a+(b-a)*t;
const D2R = Math.PI/180, R2D = 180/Math.PI;
function smoothstep(a,b,x){ const t = clamp((x-a)/(b-a),0,1); return t*t*(3-2*t); }
function fin(v){ return Number.isFinite(v) ? v : 0; }

/* ---------- 3. WORLD ---------- */
const LAKES = [
  { x:  300, z: -200, r: 130, level:  -8 },
  { x: -430, z:  360, r: 165, level: -12 },
  { x: -170, z: -540, r:  95, level:  -5 },
  { x:  520, z:  430, r: 110, level:  -6 }
];
function baseH(x,z){
  return Math.sin(x*0.0035)*Math.cos(z*0.0041)*24
       + Math.sin(x*0.0110+1.7)*Math.cos(z*0.0090-0.6)*8
       + Math.sin(x*0.0240-2.1)*Math.cos(z*0.0270+1.2)*2.6;
}
function gAt(x,z){
  let h = baseH(x,z);
  for (let i=0;i<LAKES.length;i++){
    const L = LAKES[i];
    const d = Math.hypot(x-L.x, z-L.z), R = L.r*1.35;
    if (d < R){ const s = smoothstep(0,1,1-d/R); h = h*(1-s) + (L.level-4)*s; }
  }
  return h;
}
function overWater(x,z){
  for (let i=0;i<LAKES.length;i++){
    const L = LAKES[i];
    if (Math.hypot(x-L.x, z-L.z) < L.r) return true;
  }
  return false;
}

/* ---------- 4. STATE ---------- */
const HOME = { x:0, z:0 };
const S = {
  x:0, y:0, z:0, vx:0, vy:0, vz:0,
  yaw:0, pitch:0, roll:0,          // rad. pitch +=nose up, roll +=right wing down
  tilt:0,                          // rad. 0 = hover, 88deg = cruise
  throttle:0, armed:false, crashed:false, landed:true,
  mode:'HOVER',
  battJ: BATT_J, tank: SPEC.tankML, spraying:false,
  volts: 16.8, amps: 0, mAh: 0,
  flightT:0, power:0, T12:0, T3:0, airspeed:0, agl:0,
  holdX:0, holdZ:0, altI:0, asI:0,
  wps:[], wpIdx:0, phase:'IDLE', phaseT:0, missionOn:false, rth:false
};
const IN = { thr:0, alt:30, as:18, yawStick:0, pitchStick:0, trim:0, inspectTilt:0 };
const WIND = { spd:0, dir:0, gust:0.3, gx:0, gz:0, gt:0 };

/* ---------- 5. THREE.JS SETUP ---------- */
let scene, cam, renderer, droneGrp, nacL, nacR, propL, propR, propT, sprayPts, sprayV;
let camMode = 'FOLLOW', camLock = false;
const orbit = { az: 2.4, el: 0.34, dist: 14, dragging:false, px:0, py:0, spin:false };

function initScene(){
  scene = new THREE.Scene();
  scene.background = new THREE.Color(0x93b8d4);
  scene.fog = new THREE.Fog(0x93b8d4, 260, 1500);

  cam = new THREE.PerspectiveCamera(62, innerWidth/innerHeight, 0.04, 4200);
  cam.position.set(9, 8, 14);
  cam.lookAt(0, 2, 0);

  renderer = new THREE.WebGLRenderer({ antialias:true, powerPreference:'high-performance' });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 1.6));
  renderer.setSize(innerWidth, innerHeight);
  document.getElementById('view').appendChild(renderer.domElement);

  scene.add(new THREE.HemisphereLight(0xcfe4f5, 0x38492f, 0.95));
  const sun = new THREE.DirectionalLight(0xfff2dc, 0.85);
  sun.position.set(240, 380, 160);
  scene.add(sun);
}

function buildTerrain(){
  const SIZE = 2600, SEG = 150;
  const g = new THREE.PlaneGeometry(SIZE, SIZE, SEG, SEG);
  const p = g.attributes.position;
  for (let i=0;i<p.count;i++){
    // plane is in XY; after rotateX(-PI/2) the local +y maps to world -z
    p.setZ(i, gAt(p.getX(i), -p.getY(i)));
  }
  g.rotateX(-Math.PI/2);
  g.computeVertexNormals();
  const m = new THREE.MeshLambertMaterial({ color:0x4d6b3c, flatShading:true });
  scene.add(new THREE.Mesh(g, m));

  // lakes
  const wm = new THREE.MeshLambertMaterial({
    color:0x2c6f96, transparent:true, opacity:0.82 });
  for (let i=0;i<LAKES.length;i++){
    const L = LAKES[i];
    const w = new THREE.Mesh(new THREE.CircleGeometry(L.r, 46), wm);
    w.rotation.x = -Math.PI/2;
    w.position.set(L.x, L.level, L.z);
    scene.add(w);
  }

  // home pad
  const pad = new THREE.Mesh(
    new THREE.CircleGeometry(6, 28),
    new THREE.MeshBasicMaterial({ color:0x4ad07f, transparent:true, opacity:0.35 }));
  pad.rotation.x = -Math.PI/2;
  pad.position.set(HOME.x, gAt(HOME.x, HOME.z)+0.12, HOME.z);
  scene.add(pad);
}

function buildForest(){
  const N = 3600;
  const trunkG = new THREE.CylinderGeometry(0.32, 0.46, 4.4, 5);
  const leafG  = new THREE.ConeGeometry(2.5, 9.5, 6);
  const trunkM = new THREE.MeshLambertMaterial({ color:0x4a3826 });
  const leafM  = new THREE.MeshLambertMaterial({ color:0x2f5228, flatShading:true });
  const tI = new THREE.InstancedMesh(trunkG, trunkM, N);
  const lI = new THREE.InstancedMesh(leafG,  leafM,  N);
  const M = new THREE.Matrix4(), Q = new THREE.Quaternion();
  const Pv = new THREE.Vector3(), Sv = new THREE.Vector3();
  let n = 0, guard = 0;
  while (n < N && guard < N*7){
    guard++;
    const x = (Math.random()-0.5)*2350, z = (Math.random()-0.5)*2350;
    if (Math.hypot(x-HOME.x, z-HOME.z) < 26) continue;   // keep the pad clear
    if (overWater(x,z)) continue;
    const h = gAt(x,z);
    if (h < -3) continue;                                 // no trees in the basins
    const s = 0.62 + Math.random()*0.95;
    Q.setFromAxisAngle(new THREE.Vector3(0,1,0), Math.random()*6.283);
    Pv.set(x, h+2.2*s, z); Sv.set(s,s,s);
    M.compose(Pv, Q, Sv); tI.setMatrixAt(n, M);
    Pv.set(x, h+8.4*s, z);
    M.compose(Pv, Q, Sv); lI.setMatrixAt(n, M);
    n++;
  }
  tI.count = n; lI.count = n;
  tI.instanceMatrix.needsUpdate = true;
  lI.instanceMatrix.needsUpdate = true;
  scene.add(tI); scene.add(lI);
}

/* ---------- 6. THE AIRCRAFT ---------- */
function buildDrone(){
  droneGrp = new THREE.Group();

  // delta / manta planform. shape drawn in XY with +y = nose.
  const pts = [
    [0.000, 0.245],[0.055, 0.212],[0.150, 0.108],[0.268, -0.012],
    [0.392,-0.104],[0.378,-0.163],[0.196,-0.152],[0.104,-0.243],[0.000,-0.212]
  ];
  const sh = new THREE.Shape();
  sh.moveTo(pts[0][0], pts[0][1]);
  for (let i=1;i<pts.length;i++) sh.lineTo(pts[i][0], pts[i][1]);
  for (let i=pts.length-2;i>=1;i--) sh.lineTo(-pts[i][0], pts[i][1]);
  sh.closePath();

  const bodyG = new THREE.ExtrudeGeometry(sh, { depth:0.036, bevelEnabled:false });
  bodyG.rotateX(Math.PI/2);          // nose now points +Z, thickness runs -Y
  bodyG.translate(0, 0.018, 0);
  bodyG.computeVertexNormals();
  const wingM = new THREE.MeshLambertMaterial({ color:0xe8eef4, flatShading:true });
  droneGrp.add(new THREE.Mesh(bodyG, wingM));

  // centre pod
  const pod = new THREE.Mesh(
    new THREE.SphereGeometry(0.062, 14, 10),
    new THREE.MeshLambertMaterial({ color:0xd2dae2 }));
  pod.scale.set(1, 0.72, 3.0);
  pod.position.set(0, 0.038, 0.055);
  droneGrp.add(pod);

  // nose camera
  const camB = new THREE.Mesh(
    new THREE.BoxGeometry(0.05, 0.03, 0.03),
    new THREE.MeshLambertMaterial({ color:0x1b232c }));
  camB.position.set(0, 0.012, 0.212);
  droneGrp.add(camB);

  // winglets
  const wgM = new THREE.MeshLambertMaterial({ color:0xc3ccd6 });
  for (const sgn of [-1, 1]){
    const wg = new THREE.Mesh(new THREE.BoxGeometry(0.012, 0.052, 0.075), wgM);
    wg.position.set(sgn*0.386, 0.040, -0.132);
    droneGrp.add(wg);
  }

  // ---- nacelle factory ----
  function nacelle(){
    const g = new THREE.Group();
    const body = new THREE.Mesh(
      new THREE.CylinderGeometry(0.026, 0.026, 0.088, 10),
      new THREE.MeshLambertMaterial({ color:0xdfe6ed }));
    body.rotation.x = Math.PI/2;      // long axis along local Z (thrust axis)
    g.add(body);
    const hub = new THREE.Mesh(
      new THREE.CylinderGeometry(0.014,0.014,0.022,8),
      new THREE.MeshLambertMaterial({ color:0x2a3138 }));
    hub.rotation.x = Math.PI/2; hub.position.z = 0.052;
    g.add(hub);
    const disc = new THREE.Mesh(
      new THREE.CircleGeometry(SPEC.propR, 22),
      new THREE.MeshBasicMaterial({ color:0x8fa6b8, transparent:true,
        opacity:0.22, side:THREE.DoubleSide }));
    disc.position.z = 0.058;
    g.add(disc);
    const blades = new THREE.Group();
    for (let i=0;i<2;i++){
      const b = new THREE.Mesh(
        new THREE.BoxGeometry(SPEC.propR*2, 0.004, 0.017),
        new THREE.MeshLambertMaterial({ color:0x20262c }));
      b.rotation.z = i * Math.PI/2;
      blades.add(b);
    }
    blades.position.z = 0.059;
    blades.rotation.x = Math.PI/2;
    g.add(blades);
    g.userData.blades = blades;
    g.userData.disc = disc;
    return g;
  }

  // front tilting nacelles (560 mm centre spacing -> +-0.28 m), mounted forward
  nacL = nacelle(); nacL.position.set(-0.280, 0.034, 0.058); droneGrp.add(nacL);
  nacR = nacelle(); nacR.position.set( 0.280, 0.034, 0.058); droneGrp.add(nacR);
  // fixed tail lift motor, 110 mm forward of trailing edge, on centreline
  const tail = nacelle();
  tail.position.set(0, 0.052, -0.140);
  tail.rotation.x = -Math.PI/2;      // permanently vertical (thrust up)
  droneGrp.add(tail);

  propL = nacL.userData.blades;
  propR = nacR.userData.blades;
  propT = tail.userData.blades;

  scene.add(droneGrp);

  // spray particles
  const cnt = 260;
  const pg = new THREE.BufferGeometry();
  const pa = new Float32Array(cnt*3);
  pg.setAttribute('position', new THREE.BufferAttribute(pa, 3));
  sprayPts = new THREE.Points(pg, new THREE.PointsMaterial({
    color:0x9fd8ef, size:0.42, transparent:true, opacity:0.85,
    sizeAttenuation:true, depthWrite:false }));
  sprayPts.visible = false;
  sprayPts.frustumCulled = false;
  scene.add(sprayPts);
  sprayV = new Float32Array(cnt*3);
  for (let i=0;i<cnt;i++) pa[i*3+1] = -9999;
}

/* ---------- 7. MOTOR POWER (momentum theory) ---------- */
function motorPower(T, vAxial){
  if (T < 1e-4) return 0;
  const V = Math.max(0, vAxial);
  let vi = Math.sqrt(T / (2*RHO*DISK));           // hover induced velocity
  for (let k=0;k<6;k++) vi = T / (2*RHO*DISK*(V + vi));
  const ideal = T * (V + vi);
  const eta = 0.35 + 0.27*Math.min(1, V/15);      // static -> forward flight efficiency
  return ideal / eta;
}

/* ---------- 8. FLIGHT DYNAMICS ---------- */
const _e = new THREE.Euler(0,0,0,'YXZ');
const _q = new THREE.Quaternion();
const _qi= new THREE.Quaternion();
const _v = new THREE.Vector3();

function physics(dt){
  if (S.crashed) { S.throttle = 0; return; }

  /* --- wind + gusts --- */
  WIND.gt += dt;
  const gAmp = WIND.spd * WIND.gust * 0.55;
  WIND.gx = Math.sin(WIND.gt*0.9)*gAmp + Math.sin(WIND.gt*2.7+1.3)*gAmp*0.4;
  WIND.gz = Math.cos(WIND.gt*0.75+0.6)*gAmp + Math.cos(WIND.gt*3.1)*gAmp*0.35;
  const wr = WIND.dir * D2R;
  const wx = -Math.sin(wr)*WIND.spd + WIND.gx;
  const wz = -Math.cos(wr)*WIND.spd + WIND.gz;

  /* --- air-relative velocity --- */
  const rax = S.vx - wx, ray = S.vy, raz = S.vz - wz;
  S.airspeed = Math.hypot(rax, ray, raz);

  const gh = gAt(S.x, S.z);
  S.agl = S.y - gh;

  /* --- body frame --- */
  _e.set(-S.pitch, S.yaw, -S.roll, 'YXZ');
  _q.setFromEuler(_e);
  _qi.copy(_q).invert();
  const vB = _v.set(rax, ray, raz).applyQuaternion(_qi).clone();
  const u = vB.z;                                  // forward airspeed component

  /* ══ CONTROL LAWS ══ */
  let tiltT = 0, thrCmd = 0, pitchCmd = 0, rollCmd = 0, yawRate = 0;
  const battFrac = S.battJ / BATT_J;

  if (!S.armed){
    // on the ground: let the tilt scrubber drive the nacelles through the real
    // servo slew limiter so the transition mechanism can be inspected properly
    tiltT = clamp(IN.inspectTilt, 0, 90) * D2R;
    thrCmd = 0; pitchCmd = 0; rollCmd = 0;
  }
  else if (S.mode === 'HOVER'){
    tiltT = 0;
    thrCmd = clamp(IN.thr + IN.trim, 0, 1);
    pitchCmd = IN.pitchStick * 0.30;
    rollCmd  = 0;
    yawRate  = IN.yawStick * 1.25;
  }
  else if (S.mode === 'POSHOLD'){
    tiltT = 0;
    const r = poshold(dt, S.holdX, S.holdZ, IN.alt);
    thrCmd = r.thr; pitchCmd = r.pitch; rollCmd = r.roll;
    yawRate = IN.yawStick * 1.1;
  }
  else if (S.mode === 'CRUISE'){
    tiltT = SPEC.cruiseTilt * D2R;
    const r = cruise(dt, IN.as, IN.alt, u);
    thrCmd = r.thr; pitchCmd = r.pitch; rollCmd = r.roll; yawRate = r.yawRate;
  }
  else if (S.mode === 'MISSION'){
    const r = mission(dt, u);
    tiltT = r.tilt; thrCmd = r.thr; pitchCmd = r.pitch;
    rollCmd = r.roll; yawRate = r.yawRate;
  }

  /* dead battery = dead motors */
  let avail = 1;
  if (battFrac <= 0) avail = 0;
  else if (battFrac < 0.04) avail = battFrac/0.04;
  thrCmd = clamp(thrCmd, 0, 1) * avail;

  /* --- servo slew limit on the nacelles --- */
  const maxD = SPEC.tiltRate * D2R * dt;
  S.tilt += clamp(tiltT - S.tilt, -maxD, maxD);
  S.tilt = clamp(S.tilt, 0, 90*D2R);

  /* --- attitude tracking (first-order, deliberately forgiving) --- */
  const kAtt = 1 - Math.exp(-6.5*dt);
  S.pitch += (clamp(pitchCmd,-0.45,0.45) - S.pitch) * kAtt;
  S.roll  += (clamp(rollCmd, -0.60,0.60) - S.roll ) * kAtt;
  S.yaw   += yawRate * dt;
  if (S.yaw >  Math.PI) S.yaw -= 2*Math.PI;
  if (S.yaw < -Math.PI) S.yaw += 2*Math.PI;
  S.throttle = thrCmd;

  /* --- thrust --- */
  const rearOn = 1 - smoothstep(45*D2R, 80*D2R, S.tilt);   // M3 shuts down for cruise
  const Tf = SPEC.motorTmax * thrCmd*thrCmd;               // per front motor
  const Tr = SPEC.motorTmax * thrCmd*thrCmd * rearOn;
  S.T12 = Tf; S.T3 = Tr;
  const Tby = 2*Tf*Math.cos(S.tilt) + Tr;
  const Tbz = 2*Tf*Math.sin(S.tilt);
  const tW = new THREE.Vector3(0, Tby, Tbz).applyQuaternion(_q);

  /* --- aerodynamics --- */
  let aW = new THREE.Vector3(0,0,0);
  if (S.airspeed > 0.8){
    let alpha = 0;
    if (u > 0.6) alpha = clamp(Math.atan2(-vB.y, u), -0.45, 0.45);
    let CL = SPEC.CL0 + SPEC.CLa * alpha;
    if (Math.abs(CL) > SPEC.CLmax)                      // gentle post-stall
      CL = Math.sign(CL) * (SPEC.CLmax - 0.35*(Math.abs(CL)-SPEC.CLmax));
    let CD = SPEC.CD0 + CL*CL/(Math.PI*SPEC.AR*SPEC.oswald);
    // blend toward flat-plate drag when the wing is not aligned with the flow
    const flat = 1 - Math.min(1, Math.abs(u)/Math.max(S.airspeed, 0.01));
    CD = CD*(1-flat) + 1.15*flat;
    CL = CL*(1-flat);
    const qb = 0.5*RHO*S.airspeed*S.airspeed*SPEC.wingArea;
    const vhat = vB.clone().normalize();
    const by = new THREE.Vector3(0,1,0);
    const ld = by.clone().sub(vhat.clone().multiplyScalar(by.dot(vhat)));
    if (ld.lengthSq() > 1e-6) ld.normalize(); else ld.set(0,1,0);
    aW = ld.multiplyScalar(qb*CL)
           .add(vhat.multiplyScalar(-qb*CD))
           .applyQuaternion(_q);
  }
  // parasitic drag from the pod, nacelles and spinning discs — acts from any
  // direction, which is what makes crosswind actually push the aircraft around
  if (S.airspeed > 0.3){
    const qp = 0.5*RHO*S.airspeed*S.airspeed*SPEC.paraCdA / S.airspeed;
    aW.x -= qp*rax; aW.y -= qp*ray; aW.z -= qp*raz;
  }

  /* --- integrate --- */
  const ax = (tW.x + aW.x) / SPEC.mass;
  const ay = (tW.y + aW.y) / SPEC.mass - G;
  const az = (tW.z + aW.z) / SPEC.mass;
  S.vx += ax*dt; S.vy += ay*dt; S.vz += az*dt;
  S.x  += S.vx*dt; S.y += S.vy*dt; S.z += S.vz*dt;

  /* --- energy --- */
  const axisV = vB.y*Math.cos(S.tilt) + vB.z*Math.sin(S.tilt);
  S.power = motorPower(Tf, axisV)*2 + motorPower(Tr, vB.y)
          + SPEC.avionicsW + (S.spraying ? 2.5 : 0);
  S.battJ = Math.max(0, S.battJ - S.power*dt);

  /* --- pack voltage under load (Li-ion curve + IR sag) --- */
  const soc = S.battJ / BATT_J;
  const vcell = 3.25 + 0.72*soc + 0.23*soc*soc;      // 4.20 V full -> 3.25 V empty
  const voc = 4*vcell;
  // P = (Voc - I*R)*I   ->   R*I^2 - Voc*I + P = 0
  const disc = voc*voc - 4*SPEC.packR*S.power;
  S.amps  = disc > 0 ? (voc - Math.sqrt(disc))/(2*SPEC.packR) : voc/(2*SPEC.packR);
  S.volts = Math.max(0, voc - S.amps*SPEC.packR);
  S.mAh  += S.amps*dt/3.6;

  /* --- turbulence: low-frequency buffeting, grows with wind and airspeed --- */
  if (S.agl > 1.2 && !S.crashed){
    const ta = (0.30 + WIND.spd*0.17 + S.airspeed*0.020) * (0.55 + WIND.gust);
    S.vx += (Math.sin(WIND.gt*3.13)*Math.sin(WIND.gt*1.07+0.4)) * ta * dt;
    S.vy += (Math.sin(WIND.gt*2.41+1.9)*Math.sin(WIND.gt*0.83)) * ta * 0.75 * dt;
    S.vz += (Math.cos(WIND.gt*2.79+0.7)*Math.sin(WIND.gt*1.31+2.2)) * ta * dt;
    S.roll  += Math.sin(WIND.gt*4.7+1.2) * ta * 0.010 * dt;
    S.pitch += Math.sin(WIND.gt*5.3+0.3) * ta * 0.008 * dt;
  }

  /* --- spraying --- */
  if (S.spraying && S.tank > 0){
    S.tank = Math.max(0, S.tank - SPEC.sprayMLs*dt);
    if (S.tank <= 0){ S.spraying = false; log('Tank empty — spray stopped'); }
  }

  /* --- ground contact --- */
  const floor = gAt(S.x, S.z) + 0.07;
  if (S.y <= floor){
    const vDown = -S.vy, vh = Math.hypot(S.vx, S.vz);
    if ((vDown > SPEC.crashVy || vh > SPEC.crashVh) && S.flightT > 1.2){
      S.crashed = true; S.armed = false;
      log('CRASH — impact ' + vDown.toFixed(1) + ' m/s vert, ' + vh.toFixed(1) + ' m/s horiz');
    } else {
      S.y = floor; S.vy = 0; S.vx *= 0.55; S.vz *= 0.55;
      if (!S.landed && S.armed && S.throttle < 0.25){
        S.landed = true; log('Touchdown');
      }
      if (S.landed && S.throttle < 0.05){ S.pitch *= 0.9; S.roll *= 0.9; }
    }
  } else if (S.agl > 0.6) {
    S.landed = false;
  }

  if (S.armed && !S.crashed) S.flightT += dt;

  /* --- NaN guard --- */
  if (!Number.isFinite(S.x+S.y+S.z+S.vx+S.vy+S.vz+S.yaw+S.pitch+S.roll)){
    log('Numerical fault — state reset');
    softReset();
  }
}

/* ---------- 9. CONTROLLERS ---------- */
function poshold(dt, hx, hz, targetAGL){
  // vertical
  const eA = targetAGL - S.agl;
  const vyT = clamp(eA*0.55, -3.2, 4.0);
  const eV = vyT - S.vy;
  S.altI = clamp(S.altI + eV*dt*0.035, -0.28, 0.28);
  const thr = clamp(HOVER_THR + eV*0.055 + S.altI, 0, 1);
  // horizontal
  const ex = hx - S.x, ez = hz - S.z;
  const vxT = clamp(ex*0.42, -8, 8), vzT = clamp(ez*0.42, -8, 8);
  const axC = clamp((vxT - S.vx)*0.85, -4.2, 4.2);
  const azC = clamp((vzT - S.vz)*0.85, -4.2, 4.2);
  const sy = Math.sin(S.yaw), cy = Math.cos(S.yaw);
  const fwd = axC*sy + azC*cy;      // body forward accel
  const rgt = axC*cy - azC*sy;      // body right accel
  return {
    thr: thr,
    pitch: clamp(-Math.atan2(fwd, G), -0.32, 0.32),
    roll : clamp( Math.atan2(rgt, G), -0.32, 0.32)
  };
}

function cruise(dt, targetAS, targetAGL, u){
  const eAS = targetAS - u;
  S.asI = clamp(S.asI + eAS*dt*0.006, -0.20, 0.30);
  const thr = clamp(0.26 + eAS*0.028 + S.asI, 0.05, 1);
  const eA = targetAGL - S.agl;
  const vyT = clamp(eA*0.32, -4.5, 4.5);
  const eV = vyT - S.vy;
  const pitch = clamp(0.076 + eV*0.038, -0.16, 0.30);
  const roll = clamp(IN.yawStick * 0.48, -0.5, 0.5);
  const yawRate = (Math.abs(u) > 4) ? G*Math.tan(S.roll)/Math.max(u, 8) : 0;
  return { thr:thr, pitch:pitch, roll:roll, yawRate:yawRate };
}

function cruiseTo(dt, tx, tz, targetAGL){
  const dx = tx - S.x, dz = tz - S.z;
  const brg = Math.atan2(dx, dz);
  let err = brg - S.yaw;
  while (err >  Math.PI) err -= 2*Math.PI;
  while (err < -Math.PI) err += 2*Math.PI;
  const u = (S.vx*Math.sin(S.yaw) + S.vz*Math.cos(S.yaw));
  const roll = clamp(err*0.85, -0.46, 0.46);
  const eAS = IN.as - u;
  S.asI = clamp(S.asI + eAS*dt*0.006, -0.20, 0.30);
  const thr = clamp(0.26 + eAS*0.028 + S.asI, 0.05, 1);
  const eA = targetAGL - S.agl;
  const eV = clamp(eA*0.32, -4.5, 4.5) - S.vy;
  const pitch = clamp(0.076 + eV*0.038, -0.16, 0.30);
  const yawRate = (Math.abs(u) > 4) ? G*Math.tan(S.roll)/Math.max(u, 8) : 0;
  return { thr:thr, pitch:pitch, roll:roll, yawRate:yawRate,
           dist: Math.hypot(dx, dz) };
}

/* ---------- 10. MISSION STATE MACHINE ---------- */
const CRUISE_ALT = 55, SPRAY_ALT = 11, SPRAY_TIME = 4.0;
function setPhase(p){ S.phase = p; S.phaseT = 0; log('Mission: ' + p); }

function mission(dt, u){
  S.phaseT += dt;
  const hoverT = SPEC.cruiseTilt*D2R;
  let tgt = null;
  if (!S.rth && S.wpIdx < S.wps.length) tgt = S.wps[S.wpIdx];

  switch (S.phase){

    case 'TAKEOFF': {
      const r = poshold(dt, HOME.x, HOME.z, CRUISE_ALT);
      if (S.agl > CRUISE_ALT*0.9) setPhase(tgt ? 'TRANSIT' : 'LAND');
      return { tilt:0, thr:r.thr, pitch:r.pitch, roll:r.roll, yawRate:0 };
    }

    case 'TRANSIT': {
      if (!tgt){ setPhase('RTH'); break; }
      const r = cruiseTo(dt, tgt.x, tgt.z, CRUISE_ALT);
      if (r.dist < 45) setPhase('ARRIVE');
      return { tilt:hoverT, thr:r.thr, pitch:r.pitch, roll:r.roll, yawRate:r.yawRate };
    }

    case 'ARRIVE': {
      if (!tgt){ setPhase('RTH'); break; }
      S.holdX = tgt.x; S.holdZ = tgt.z;
      const r = poshold(dt, tgt.x, tgt.z, CRUISE_ALT);
      const near = Math.hypot(tgt.x-S.x, tgt.z-S.z) < 9;
      const slow = Math.hypot(S.vx, S.vz) < 3.2;
      if ((near && slow) || S.phaseT > 22) setPhase('DESCEND');
      return { tilt:0, thr:r.thr, pitch:r.pitch, roll:r.roll, yawRate:0 };
    }

    case 'DESCEND': {
      if (!tgt){ setPhase('RTH'); break; }
      const r = poshold(dt, tgt.x, tgt.z, SPRAY_ALT);
      if (Math.abs(S.agl - SPRAY_ALT) < 2.0 || S.phaseT > 26){
        if (S.tank > 1){ S.spraying = true; setPhase('SPRAY'); }
        else { log('No water remaining — skipping spray'); setPhase('CLIMB'); }
      }
      return { tilt:0, thr:r.thr, pitch:r.pitch, roll:r.roll, yawRate:0 };
    }

    case 'SPRAY': {
      if (!tgt){ S.spraying=false; setPhase('RTH'); break; }
      const r = poshold(dt, tgt.x, tgt.z, SPRAY_ALT);
      if (S.phaseT > SPRAY_TIME || S.tank <= 0){
        S.spraying = false;
        tgt.done = true;
        log('Waypoint ' + (S.wpIdx+1) + ' sprayed — ' + Math.round(S.tank) + ' mL left');
        setPhase('CLIMB');
      }
      return { tilt:0, thr:r.thr, pitch:r.pitch, roll:r.roll, yawRate:0 };
    }

    case 'CLIMB': {
      const hx = tgt ? tgt.x : S.x, hz = tgt ? tgt.z : S.z;
      const r = poshold(dt, hx, hz, CRUISE_ALT);
      if (S.agl > CRUISE_ALT*0.9 || S.phaseT > 30){
        S.wpIdx++;
        if (S.wpIdx < S.wps.length) setPhase('TRANSIT');
        else setPhase('RTH');
      }
      return { tilt:0, thr:r.thr, pitch:r.pitch, roll:r.roll, yawRate:0 };
    }

    case 'RTH': {
      S.rth = true;
      const r = cruiseTo(dt, HOME.x, HOME.z, CRUISE_ALT);
      if (r.dist < 45) setPhase('APPROACH');
      return { tilt:hoverT, thr:r.thr, pitch:r.pitch, roll:r.roll, yawRate:r.yawRate };
    }

    case 'APPROACH': {
      const r = poshold(dt, HOME.x, HOME.z, CRUISE_ALT*0.55);
      const near = Math.hypot(HOME.x-S.x, HOME.z-S.z) < 8;
      const slow = Math.hypot(S.vx, S.vz) < 3.0;
      if ((near && slow) || S.phaseT > 25) setPhase('LAND');
      return { tilt:0, thr:r.thr, pitch:r.pitch, roll:r.roll, yawRate:0 };
    }

    case 'LAND': {
      const tAlt = Math.max(0, S.agl - 2.0);        // always command 2 m below us
      const r = poshold(dt, HOME.x, HOME.z, tAlt);
      if (S.agl < 0.5){
        setPhase('DONE'); S.missionOn = false;
        S.tank = SPEC.tankML;
        log('Mission complete — landed, tank refilled');
      }
      return { tilt:0, thr:r.thr*0.98, pitch:r.pitch, roll:r.roll, yawRate:0 };
    }

    default: {                                     // DONE / IDLE
      const r = poshold(dt, HOME.x, HOME.z, 0);
      return { tilt:0, thr: S.agl > 0.4 ? r.thr : 0, pitch:0, roll:0, yawRate:0 };
    }
  }
  return { tilt:0, thr:HOVER_THR, pitch:0, roll:0, yawRate:0 };
}

/* ---------- 11. VISUALS ---------- */
let spinL=0, spinR=0, spinT=0;
function updateVisuals(dt){
  droneGrp.position.set(S.x, S.y, S.z);
  droneGrp.rotation.set(-S.pitch, S.yaw, -S.roll, 'YXZ');

  /* airframe shake — prop imbalance (fast, throttle-linked) layered over
     aero buffeting (slower, wind-linked). Visual only; physics untouched. */
  if (!S.crashed){
    const t  = S.flightT;
    const gnd = S.landed ? 0.22 : 1;
    const hi = (0.0016 + 0.0075*S.throttle) * gnd;                      // prop buzz
    const lo = (0.0022 + WIND.spd*0.0016 + S.airspeed*0.00035) * gnd;   // buffeting
    droneGrp.position.x += Math.sin(t*61.3)*hi      + Math.sin(t*7.7+0.5)*lo;
    droneGrp.position.y += Math.sin(t*73.1+1.1)*hi  + Math.sin(t*5.9+2.1)*lo;
    droneGrp.position.z += Math.sin(t*67.9+2.3)*hi  + Math.sin(t*9.1+1.3)*lo;
    droneGrp.rotation.z += Math.sin(t*8.3+0.7)*lo*1.9 + Math.sin(t*57.1)*hi*0.8;
    droneGrp.rotation.x += Math.sin(t*6.7+1.9)*lo*1.5 + Math.sin(t*64.7+1.4)*hi*0.7;
  }

  // nacelle props face local +Z at rest, so bias by -90 deg:
  //   tilt 0   -> rotation -90 deg -> thrust UP      (hover / poshold)
  //   tilt 88  -> rotation  -2 deg -> thrust FORWARD (cruise)
  nacL.rotation.x = S.tilt - Math.PI/2;
  nacR.rotation.x = S.tilt - Math.PI/2;

  const rearOn = 1 - smoothstep(45*D2R, 80*D2R, S.tilt);
  const rpmF = S.throttle * 78, rpmR = S.throttle * 78 * rearOn;
  spinL += rpmF*dt; spinR -= rpmF*dt; spinT += rpmR*dt;
  propL.rotation.y = spinL; propR.rotation.y = spinR; propT.rotation.y = spinT;
  nacL.userData.disc.material.opacity = 0.08 + 0.30*S.throttle;
  nacR.userData.disc.material.opacity = 0.08 + 0.30*S.throttle;

  // spray particles
  const pa = sprayPts.geometry.attributes.position.array;
  const n = pa.length/3;
  sprayPts.visible = true;
  for (let i=0;i<n;i++){
    const k = i*3;
    if (pa[k+1] < -5000){
      if (S.spraying && Math.random() < 0.55){
        pa[k]   = S.x + (Math.random()-0.5)*0.12;
        pa[k+1] = S.y - 0.05;
        pa[k+2] = S.z + (Math.random()-0.5)*0.12;
        sprayV[k]   = S.vx*0.5 + (Math.random()-0.5)*1.6;
        sprayV[k+1] = -2.2 - Math.random()*1.5;
        sprayV[k+2] = S.vz*0.5 + (Math.random()-0.5)*1.6;
      }
      continue;
    }
    sprayV[k+1] -= 9.81*dt*0.55;
    pa[k]   += sprayV[k]*dt;
    pa[k+1] += sprayV[k+1]*dt;
    pa[k+2] += sprayV[k+2]*dt;
    if (pa[k+1] < gAt(pa[k], pa[k+2]) + 0.1) pa[k+1] = -9999;
  }
  sprayPts.geometry.attributes.position.needsUpdate = true;
}

function updateCamera(dt){
  if (camLock && camMode !== 'ORBIT') return;
  const k = 1 - Math.exp(-5.0*dt);
  const fwd = new THREE.Vector3(Math.sin(S.yaw), 0, Math.cos(S.yaw));

  if (camMode === 'FOLLOW'){
    const p = new THREE.Vector3(S.x,S.y,S.z)
      .sub(fwd.clone().multiplyScalar(11)).add(new THREE.Vector3(0,4.2,0));
    p.y = Math.max(p.y, gAt(p.x,p.z)+1.6);
    cam.position.lerp(p, k);
    cam.lookAt(S.x, S.y+0.5, S.z);
  } else if (camMode === 'CHASE'){
    const p = new THREE.Vector3(S.x,S.y,S.z)
      .sub(fwd.clone().multiplyScalar(24)).add(new THREE.Vector3(0,9,0));
    p.y = Math.max(p.y, gAt(p.x,p.z)+3);
    cam.position.lerp(p, k*0.5);
    cam.lookAt(S.x, S.y, S.z);
  } else if (camMode === 'FPV'){
    const off = new THREE.Vector3(0, 0.10, 0.30)
      .applyEuler(new THREE.Euler(-S.pitch, S.yaw, -S.roll, 'YXZ'));
    cam.position.set(S.x+off.x, S.y+off.y, S.z+off.z);
    const la = new THREE.Vector3(0,0,10).applyEuler(
      new THREE.Euler(-S.pitch, S.yaw, -S.roll, 'YXZ'));
    cam.lookAt(S.x+la.x, S.y+la.y, S.z+la.z);
  } else if (camMode === 'INSPECT'){
    // close-range airframe inspection — no ground clamp, so you can get underneath
    if (orbit.spin) orbit.az += dt*0.42;
    cam.position.set(
      S.x + orbit.dist*Math.cos(orbit.el)*Math.sin(orbit.az),
      S.y + orbit.dist*Math.sin(orbit.el),
      S.z + orbit.dist*Math.cos(orbit.el)*Math.cos(orbit.az));
    cam.lookAt(S.x, S.y, S.z);
  } else { // ORBIT
    if (orbit.spin) orbit.az += dt*0.42;
    const p = new THREE.Vector3(
      S.x + orbit.dist*Math.cos(orbit.el)*Math.sin(orbit.az),
      S.y + orbit.dist*Math.sin(orbit.el),
      S.z + orbit.dist*Math.cos(orbit.el)*Math.cos(orbit.az));
    p.y = Math.max(p.y, gAt(p.x,p.z)+1.2);
    cam.position.copy(p);
    cam.lookAt(S.x, S.y, S.z);
  }
}

/* ---------- 12. HUD ---------- */
const $ = id => document.getElementById(id);
function fmtT(s){
  const m = Math.floor(s/60), r = Math.floor(s%60);
  return String(m).padStart(2,'0')+':'+String(r).padStart(2,'0');
}
function updateHUD(){
  const gs = Math.hypot(S.vx, S.vz);
  $('modeTag').textContent = S.crashed ? 'CRASHED'
    : (!S.armed ? 'DISARMED'
    : (S.mode === 'MISSION' ? 'MSN · ' + S.phase : S.mode));
  $('tAlt').textContent = S.agl.toFixed(1)+' m';
  $('tGs').textContent  = gs.toFixed(1)+' m/s';
  $('tAs').textContent  = S.airspeed.toFixed(1)+' m/s';
  $('tVs').textContent  = (S.vy>=0?'+':'')+S.vy.toFixed(1)+' m/s';
  let hdg = (S.yaw*R2D)%360; if (hdg<0) hdg+=360;
  $('tHdg').textContent = String(Math.round(hdg)).padStart(3,'0')+'\u00B0';
  $('tPit').textContent = (S.pitch*R2D).toFixed(1)+'\u00B0';
  $('tRol').textContent = (S.roll*R2D).toFixed(1)+'\u00B0';

  $('tTilt').textContent = Math.round(S.tilt*R2D)+'\u00B0';
  const tp = Math.round(S.throttle*100);
  $('tThr').textContent = tp+'%';
  $('mThr').style.width = tp+'%';
  $('mThr').style.background = tp>85 ? 'var(--bad)' : (tp>65?'var(--warn)':'var(--ok)');
  $('tT12').textContent = Math.round(S.T12/G*1000)+' g';
  $('tT3').textContent  = Math.round(S.T3 /G*1000)+' g';
  $('tPw').textContent  = Math.round(S.power)+' W';

  const bp = S.battJ/BATT_J*100;
  $('tVolt').textContent = S.volts.toFixed(2)+' V';
  $('tCell').textContent = (S.volts/4).toFixed(2)+' V';
  $('tAmp').textContent  = S.amps.toFixed(1)+' A';
  $('tBat').textContent  = bp.toFixed(1)+'%';
  $('mBat').style.width  = bp+'%';
  $('mBat').style.background = bp<15 ? 'var(--bad)' : (bp<35?'var(--warn)':'var(--ok)');
  $('tMah').textContent  = Math.round(S.mAh)+' / '+Math.round(SPEC.packAh*1000);
  $('tWh').textContent   = ((BATT_J-S.battJ)/3600).toFixed(1)+' / '+SPEC.batteryWh.toFixed(1);
  $('tEnd').textContent  = (S.power>5 && bp>0) ? fmtT(S.battJ/S.power) : '--';
  const tk = S.tank/SPEC.tankML*100;
  $('tTank').textContent = Math.round(S.tank)+' mL';
  $('mTank').style.width = tk+'%';
  $('tFt').textContent = fmtT(S.flightT);

  const al = $('alert');
  al.className = '';
  if (S.crashed){ al.className='e'; al.textContent='AIRFRAME LOST — RESET REQUIRED'; }
  else if (bp <= 0){ al.className='e'; al.textContent='BATTERY DEAD — NO THRUST'; }
  else if (bp < 15){ al.className='e'; al.textContent='CRITICAL BATTERY — LAND NOW'; }
  else if (S.mode==='CRUISE' && S.armed && S.airspeed < STALL_V && S.agl>3){
    al.className='w'; al.textContent='LOW AIRSPEED — STALL RISK'; }
  else if (bp < 30){ al.className='w'; al.textContent='LOW BATTERY'; }
  else if (Math.round(S.throttle*100) > 92){ al.className='w'; al.textContent='THROTTLE SATURATED'; }
}

/* ---------- 13. MAP ---------- */
const mapC = $('map'), mx = mapC.getContext('2d');
const MAP_M = 1600;                                   // metres across
function w2m(x,z){
  return { px: (x/MAP_M + 0.5)*mapC.width, py: (0.5 - z/MAP_M)*mapC.height };
}
function m2w(px,py){
  return { x:(px/mapC.width - 0.5)*MAP_M, z:(0.5 - py/mapC.height)*MAP_M };
}
function drawMap(){
  const W = mapC.width, H = mapC.height;
  mx.fillStyle = '#0d141b'; mx.fillRect(0,0,W,H);
  // lakes
  mx.fillStyle = 'rgba(44,111,150,.55)';
  for (const L of LAKES){
    const p = w2m(L.x, L.z);
    mx.beginPath(); mx.arc(p.px, p.py, L.r/MAP_M*W, 0, 6.283); mx.fill();
  }
  // grid
  mx.strokeStyle = 'rgba(36,48,64,.7)'; mx.lineWidth = 1;
  for (let i=1;i<4;i++){
    mx.beginPath(); mx.moveTo(W*i/4,0); mx.lineTo(W*i/4,H); mx.stroke();
    mx.beginPath(); mx.moveTo(0,H*i/4); mx.lineTo(W,H*i/4); mx.stroke();
  }
  // route
  if (S.wps.length){
    mx.strokeStyle = 'rgba(232,183,63,.55)'; mx.lineWidth = 1.2;
    mx.beginPath();
    const h = w2m(HOME.x, HOME.z); mx.moveTo(h.px, h.py);
    for (const w of S.wps){ const p = w2m(w.x,w.z); mx.lineTo(p.px,p.py); }
    mx.lineTo(h.px,h.py); mx.stroke();
  }
  // waypoints
  S.wps.forEach((w,i)=>{
    const p = w2m(w.x,w.z);
    mx.fillStyle = w.done ? '#4ad07f' : '#e8b73f';
    mx.beginPath(); mx.arc(p.px,p.py,4.2,0,6.283); mx.fill();
    mx.fillStyle = '#0b0f14'; mx.font='bold 7px monospace';
    mx.textAlign='center'; mx.textBaseline='middle';
    mx.fillText(String(i+1), p.px, p.py+0.5);
  });
  // home
  const h = w2m(HOME.x,HOME.z);
  mx.strokeStyle='#4ad07f'; mx.lineWidth=1.6;
  mx.strokeRect(h.px-3.5,h.py-3.5,7,7);
  // aircraft
  const a = w2m(S.x,S.z);
  mx.save(); mx.translate(a.px,a.py); mx.rotate(S.yaw);
  mx.fillStyle = S.crashed ? '#e8574a' : '#3fb9d8';
  mx.beginPath(); mx.moveTo(0,-7); mx.lineTo(5,6); mx.lineTo(0,3.2);
  mx.lineTo(-5,6); mx.closePath(); mx.fill();
  mx.restore();
}

/* ---------- 14. LOG ---------- */
const logEl = $('log');
let logN = 0;
function log(msg){
  const d = document.createElement('div');
  d.textContent = fmtT(S.flightT) + '  ' + msg;
  logEl.insertBefore(d, logEl.firstChild);
  if (++logN > 60){ logEl.removeChild(logEl.lastChild); logN--; }
}

/* ---------- 15. UI WIRING ---------- */
function setMode(m){
  if (S.crashed) return;
  S.mode = m;
  ['HOVER','POSHOLD','CRUISE','MISSION'].forEach(k=>
    $('m'+k).classList.toggle('on', k===m));
  if (m === 'POSHOLD' || m === 'HOVER'){ S.holdX = S.x; S.holdZ = S.z; }
  S.altI = 0; S.asI = 0;
  if (m !== 'MISSION'){ S.missionOn = false; S.spraying = false; }
  log('Mode -> ' + m);
}
['HOVER','POSHOLD','CRUISE','MISSION'].forEach(k=>
  $('m'+k).onclick = ()=> setMode(k));

const CAMS = ['FOLLOW','CHASE','ORBIT','FPV','INSPECT'];
CAMS.forEach(k=>
  $('c'+k).onclick = ()=>{
    camMode = k;
    CAMS.forEach(j=> $('c'+j).classList.toggle('on', j===k));
    if (k === 'INSPECT'){
      orbit.dist = 2.1; orbit.el = 0.22; orbit.az = 2.5;
      syncZoom();
      log('Inspect view — drag to orbit, scroll to zoom, scrub tilt below');
    }
  });

$('sZoom').addEventListener('input', e=>{
  orbit.dist = parseFloat(e.target.value);
  $('vZoom').textContent = orbit.dist.toFixed(1)+' m';
  if (camMode !== 'ORBIT' && camMode !== 'INSPECT'){
    camMode = 'INSPECT';
    CAMS.forEach(j=> $('c'+j).classList.toggle('on', j==='INSPECT'));
  }
});

$('btnSpin').onclick = function(){
  orbit.spin = !orbit.spin;
  this.textContent = 'AUTO-ROTATE: ' + (orbit.spin ? 'ON' : 'OFF');
  this.classList.toggle('on', orbit.spin);
};

$('sTiltI').addEventListener('input', e=>{
  IN.inspectTilt = parseFloat(e.target.value);
  $('vTiltI').textContent = Math.round(IN.inspectTilt)+'\u00B0';
  if (S.armed) log('Tilt scrub ignored — aircraft is armed');
});

$('btnLock').onclick = function(){
  camLock = !camLock;
  this.textContent = 'VIEW LOCK: ' + (camLock ? 'ON' : 'OFF');
  this.classList.toggle('on', camLock);
};

$('btnArm').onclick = function(){
  if (S.crashed){ log('Reset the flight first'); return; }
  S.armed = !S.armed;
  this.textContent = S.armed ? 'DISARM' : 'ARM & LAUNCH';
  this.classList.toggle('on', S.armed);
  if (S.armed){
    S.holdX = S.x; S.holdZ = S.z;
    log('Armed — 4S pack ' + (S.battJ/BATT_J*100).toFixed(0) + '%');
    if (S.mode === 'HOVER' && IN.thr < 0.35){
      IN.thr = HOVER_THR; $('sThr').value = Math.round(HOVER_THR*100);
      $('vThr').textContent = Math.round(HOVER_THR*100)+'%';
      log('Throttle preset to hover (' + Math.round(HOVER_THR*100) + '%)');
    }
  } else log('Disarmed');
};

$('btnReset').onclick = ()=> hardReset();
$('btnStart').onclick = ()=>{
  if (!S.wps.length){ log('No waypoints — click the map first'); return; }
  S.wps.forEach(w=> w.done = false);
  S.wpIdx = 0; S.rth = false; S.missionOn = true;
  if (!S.armed){ S.armed = true; $('btnArm').textContent='DISARM';
    $('btnArm').classList.add('on'); }
  setMode('MISSION'); setPhase('TAKEOFF');
  log('Mission started — ' + S.wps.length + ' waypoint(s)');
};
$('btnRTH').onclick = ()=>{
  if (!S.armed) return;
  S.rth = true; S.missionOn = true;
  setMode('MISSION'); setPhase('RTH');
};
$('btnClear').onclick = ()=>{ S.wps = []; S.wpIdx = 0; log('Waypoints cleared'); };

mapC.addEventListener('click', e=>{
  const r = mapC.getBoundingClientRect();
  const w = m2w((e.clientX-r.left)*mapC.width/r.width,
                (e.clientY-r.top )*mapC.height/r.height);
  if (S.wps.length >= 8){ log('Waypoint limit reached (8)'); return; }
  S.wps.push({ x:w.x, z:w.z, done:false });
  log('Waypoint ' + S.wps.length + ' set — ' +
      Math.round(Math.hypot(w.x-HOME.x, w.z-HOME.z)) + ' m from home');
});

function slider(id, valId, fn, fmt){
  const el = $(id);
  el.addEventListener('input', ()=>{
    const v = parseFloat(el.value);
    fn(v);
    $(valId).textContent = fmt(v);
  });
}
slider('sThr','vThr', v=>{ IN.thr = v/100; }, v=> Math.round(v)+'%');
slider('sAlt','vAlt', v=>{ IN.alt = v; },     v=> Math.round(v)+' m');
slider('sAs' ,'vAs' , v=>{ IN.as  = v; },     v=> v.toFixed(0)+' m/s');
slider('sWs' ,'vWs' , v=>{ WIND.spd = v; },   v=> v.toFixed(1)+' m/s');
slider('sWd' ,'vWd' , v=>{ WIND.dir = v; },   v=> Math.round(v)+'\u00B0');
slider('sGu' ,'vGu' , v=>{ WIND.gust = v/100;}, v=> Math.round(v)+'%');

const keys = {};
addEventListener('keydown', e=>{
  const k = e.key.toLowerCase();
  keys[k] = true;
  if (['a','d','w','s','q','e',' '].indexOf(k) >= 0) e.preventDefault();
});
addEventListener('keyup', e=>{ keys[e.key.toLowerCase()] = false; });

// orbit mouse
renderer_dom_events();
function renderer_dom_events(){
  const el = document.getElementById('view');
  const orbitable = ()=> camMode === 'ORBIT' || camMode === 'INSPECT';
  el.addEventListener('mousedown', e=>{
    if (!orbitable()) return;
    orbit.dragging = true; orbit.px = e.clientX; orbit.py = e.clientY;
  });
  addEventListener('mouseup', ()=> orbit.dragging = false);
  addEventListener('mousemove', e=>{
    if (!orbit.dragging) return;
    orbit.az -= (e.clientX - orbit.px)*0.006;
    // INSPECT lets you drop below the airframe to see the nacelles and tank bay
    const lo = (camMode === 'INSPECT') ? -1.05 : -0.25;
    orbit.el = clamp(orbit.el + (e.clientY - orbit.py)*0.005, lo, 1.42);
    orbit.px = e.clientX; orbit.py = e.clientY;
  });
  el.addEventListener('wheel', e=>{
    if (!orbitable()) return;
    e.preventDefault();
    orbit.dist = clamp(orbit.dist * (1 + Math.sign(e.deltaY)*0.11), 0.55, 300);
    syncZoom();
  }, { passive:false });
}
function syncZoom(){
  const s = $('sZoom');
  if (s){ s.value = Math.min(60, orbit.dist).toFixed(1);
          $('vZoom').textContent = orbit.dist.toFixed(1)+' m'; }
}

addEventListener('resize', ()=>{
  cam.aspect = innerWidth/innerHeight;
  cam.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

/* ---------- 16. RESET ---------- */
function softReset(){
  S.x=HOME.x; S.z=HOME.z; S.y=gAt(HOME.x,HOME.z)+0.07;
  S.vx=S.vy=S.vz=0; S.yaw=0; S.pitch=0; S.roll=0; S.tilt=0;
  S.altI=0; S.asI=0;
}
function hardReset(){
  softReset();
  S.armed=false; S.crashed=false; S.landed=true; S.throttle=0;
  S.battJ=BATT_J; S.tank=SPEC.tankML; S.spraying=false;
  S.mAh=0; S.amps=0; S.volts=16.8;
  S.flightT=0; S.wpIdx=0; S.rth=false; S.missionOn=false; S.phase='IDLE';
  S.wps.forEach(w=> w.done=false);
  IN.trim = 0;
  IN.inspectTilt = 0;
  const ti = $('sTiltI');
  if (ti){ ti.value = 0; $('vTiltI').textContent = '0\u00B0'; }
  $('btnArm').textContent='ARM & LAUNCH';
  $('btnArm').classList.remove('on');
  setMode('HOVER');
  log('Flight reset — pack 100%, tank 120 mL');
}

/* ---------- 17. MAIN LOOP ---------- */
let last = performance.now(), mapT = 0, hudT = 0;
function frame(now){
  requestAnimationFrame(frame);
  let dt = (now - last)/1000;
  last = now;
  if (dt > 0.05) dt = 0.05;             // clamp: backgrounded tabs must not explode
  if (dt <= 0) return;

  // keyboard
  IN.yawStick   = (keys['d']?1:0) - (keys['a']?1:0);
  IN.pitchStick = (keys['s']?1:0) - (keys['w']?1:0);
  if (keys['q']) IN.trim = clamp(IN.trim - 0.35*dt, -0.5, 0.5);
  if (keys['e']) IN.trim = clamp(IN.trim + 0.35*dt, -0.5, 0.5);

  physics(dt);
  updateVisuals(dt);
  updateCamera(dt);

  hudT += dt; if (hudT > 0.08){ updateHUD(); hudT = 0; }
  mapT += dt; if (mapT > 0.10){ drawMap();   mapT = 0; }

  renderer.render(scene, cam);
}

/* ---------- 18. BOOT ---------- */
function boot(){
  const bf = $('barf'), bm = $('bootmsg');
  const step = (pct, msg, fn, next) => setTimeout(()=>{
    bf.style.width = pct+'%'; bm.textContent = msg;
    try { fn(); } catch(err){ bm.textContent = 'ERROR: '+err.message; console.error(err); return; }
    if (next) next();
  }, 30);

  step(15, 'building scene', initScene, ()=>
  step(38, 'generating terrain', buildTerrain, ()=>
  step(58, 'assembling airframe', buildDrone, ()=>
  step(80, 'planting forest', buildForest, ()=>
  step(100, 'ready', ()=>{
    softReset();
    setMode('HOVER');
    log('FPMS-AS1 "Manta" ready at home pad');
    log('AUW ' + (SPEC.mass*1000) + ' g | hover thr ' + Math.round(HOVER_THR*100) +
        '% | stall ' + STALL_V.toFixed(1) + ' m/s');
    updateHUD(); drawMap();
    const b = $('boot');
    b.style.opacity = '0';
    setTimeout(()=> b.style.display='none', 420);
    requestAnimationFrame(frame);
  })))));
}
boot();
</script>
